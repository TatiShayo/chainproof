# CHAINPROOF HERMES v6 Environment Configuration
# Supply Chain Attestation, Sigstore, and Policy Settings

# Sigstore & Cosign Configuration
COSIGN_EXPERIMENTAL=1
FULCIO_URL=https://fulcio.sigstore.dev
REKOR_URL=https://rekor.sigstore.dev
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=example-client-id.apps.googleusercontent.com

# Chainproof Policy Engine Settings
CHAINPROOF_MIN_SLSA_LEVEL=2
CHAINPROOF_MAX_CVE_SEVERITY=HIGH
CHAINPROOF_REQUIRE_SBOM=true
CHAINPROOF_REQUIRE_SIGNATURE=true
CHAINPROOF_REQUIRE_PINNED_DEPS=true
CHAINPROOF_FLEET_CONFIG=./fleet.config.json

# Vulnerability Scanning Defaults
SYFT_CHECK_FOR_APP_UPDATE=false
GRYPE_CHECK_FOR_APP_UPDATE=false
